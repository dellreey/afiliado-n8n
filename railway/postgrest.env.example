# PostgREST -> Postgres (banco de dados do domínio: Postgres-consulta)
# Imagem: postgrest/postgrest:v12.2.8 | Porta: 3000
PGRST_DB_URI=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres.railway.internal:5432/railway
PGRST_DB_SCHEMAS=public
PGRST_DB_ANON_ROLE=postgres
PGRST_JWT_SECRET=TROQUE_POR_UM_SEGREDO_FORTE
PGRST_SERVER_PORT=3000
