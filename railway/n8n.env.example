# Variáveis do serviço n8n (Railway)
# Os workflows já usam $env.SUPABASE_URL + /rest/v1/... e
# headers apikey + Authorization: Bearer <chave>.
SUPABASE_URL=https://ofertas-api-production.up.railway.app
SUPABASE_SERVICE_KEY=TROQUE_PELO_JWT_ASSINADO_COM_PGRST_JWT_SECRET
SUPABASE_ANON_KEY=TROQUE_PELO_MESMO_JWT
# Chave de criptografia estável do n8n (evita crash "signing.hmac").
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=TROQUE_POR_32_BYTES_HEX
